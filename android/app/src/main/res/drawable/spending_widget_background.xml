<?xml version="1.0" encoding="utf-8"?>
<!-- Bậc 1 (card) của design system: nền phẳng + hairline 1dp, KHÔNG đổ bóng
     (RemoteViews không hỗ trợ BoxShadow tuỳ ý — đổ bóng qua elevation Android
     gốc sẽ đọc ra "app Flutter mặc định", đúng thứ luật 11 cấm). Bo góc 18dp
     khớp radii.lg (card) trong bảng token. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_surface" />
    <stroke android:width="1dp" android:color="@color/widget_hairline" />
    <corners android:radius="18dp" />
</shape>
